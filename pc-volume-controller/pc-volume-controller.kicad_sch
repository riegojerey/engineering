	(text "Power + PC link: Arduino Nano onboard USB (single cable).\\n+5V pin supplies the five 10k pot dividers (~0.5 mA each = ~2.5 mA).\\nADC reads ratiometrically against the 5V rail, so USB supply\\ntolerance does not shift knob position. No external supply needed."
		(exclude_from_sim no)
		(at 40.0 60.0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0de64eb3-1c1c-51c9-9619-b0304dcecf0c")
	)
